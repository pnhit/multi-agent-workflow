{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git worktree:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git worktree list:*)",
      "Bash(git merge-base:*)",
      "Bash(sh workflow/watch.sh --lint)",
      "Bash(sh workflow/notify.sh:*)",
      "Bash(sh workflow/hooks/install.sh --check)",
      "Bash(node --test:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(pnpm test:*)",
      "Bash(yarn test:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(go test:*)",
      "Bash(cargo test:*)",
      "Bash(git -C:*)",
      "Bash(git rebase:*)",
      "Bash(npm run dev:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm run dev:*)",
      "Bash(pnpm run test:*)",
      "Bash(yarn dev:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./workflow/.env)",
      "Bash(git * --no-verify)",
      "Bash(git * --no-verify *)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * --force-with-lease*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/workflow/hooks/guard-root.cjs\"",
            "timeout": 10,
            "statusMessage": "Kiểm tra lệnh git ở thư mục gốc"
          }
        ]
      }
    ]
  }
}
