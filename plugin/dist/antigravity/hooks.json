{
  "workflow": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./kit/workflow/hooks/guard-root.cjs",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/kit.mjs session-start --tool antigravity",
        "timeout": 10
      }
    ]
  }
}
